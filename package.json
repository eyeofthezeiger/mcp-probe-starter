{
  "name": "mcp-probe-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Starter agent that connects to MCP servers and records the config they report but the docs leave out: capabilities, schemas, annotations, _meta and UI hints. Read-only by default. Emits unverified call-registry candidates.",
  "license": "MIT",
  "author": "Matt Zeiger",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "mcp-probe": "src/cli.ts"
  },
  "scripts": {
    "probe": "node --env-file-if-exists=.env src/cli.ts",
    "lint": "eslint . && prettier --check . && npm run typecheck",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ci": "npm run lint && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
